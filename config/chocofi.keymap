/*
* Keymap configuration file
*/

#include <behaviors.dtsi>
#include "deck-key.dtsi"
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
};

/ {
    combos { compatible = "zmk,combos"; };

    behaviors {

        lhrm: lhrm {
            compatible = "zmk,behavior-hold-tap";
            label = "LHRM";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <100>;
            require-prior-idle-ms = <110>;
            flavor = "balanced";
            hold-trigger-key-positions = <33 25 15 5 6 16 26 34 35 27 17 7 8 18 28 29 19 5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            bindings = <&kp>, <&kp>;
        };

        rhrm: rhrm {
            compatible = "zmk,behavior-hold-tap";
            label = "RHRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <100>;
            require-prior-idle-ms = <110>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        colemak {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
  &kp Q  &kp W  &kp F  &kp P       &kp G          &kp J  &kp L  &kp U      &kp Y    &kp SEMI
  &kp A  &kp R  &kp S  &kp T       &kp D          &kp H  &kp N  &kp E      &kp I    &kp O
  &kp Z  &kp X  &kp C  &kp V       &kp B          &kp K  &kp M  &kp COMMA  &kp DOT  &kp FSLH
                &mo 3  &kp LSHIFT  &lt 4 SPACE    &mo 1  &mo 2  &mo 4
            >;

            label = "Colemak";
        };

        Nav {
            bindings = <
  &kp RA(LEFT_SHIFT)  &kp LA(RSHIFT)  &sk LG(LSHIFT)  &sk LC(LEFT_SHIFT)  &dk 1   &kp CAPS  &kp ESC    &kp BACKSPACE  &kp TAB    &kp DELETE
  &sk RALT            &sk LEFT_ALT    &sk LGUI        &sk LCTRL           &dk 2   &kp LEFT  &kp DOWN   &kp UP         &kp RIGHT  &kp ENTER
  &kp RA(LCTRL)       &kp LA(LCTRL)   &kp LG(LCTRL)   &kp LC(RCTRL)       &dk 3   &kp HOME  &kp PG_DN  &kp PG_UP      &kp END    &kp PRINTSCREEN
                                      &sk LCTRL       &sk LEFT_SHIFT      &mo 3        &none     &none      &none
            >;

            label = "Nav";
        };

        Num {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
  &kp EXCL   &kp AT            &kp HASH          &kp DOLLAR            &kp PERCENT    &kp CARET  &kp AMPERSAND          &kp ASTERISK     &kp EQUAL          &kp APOS
  &kp N1     &kp N2            &kp N3            &kp N4                &kp N5         &kp N6     &kp N7                 &kp N8           &kp N9             &kp N0
  &kp GRAVE  &kp LEFT_BRACKET  &kp LEFT_BRACE    &kp LEFT_PARENTHESIS  &kp PLUS       &kp MINUS  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp BACKSLASH
                               &kp LEFT_CONTROL  &kp LSHIFT            &kp SPACE      &none      &none                  &none
            >;

            label = "Num";
        };

        Func {
            bindings = <
  &kp C_POWER  &kp C_SLEEP  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_MUTE               &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4
  &kp F1       &kp F2       &kp F3             &kp F4           &kp F5                   &kp F6        &kp F7        &kp F8          &kp F9        &kp F10
  &kp F11      &kp F12      &kp C_BRI_DEC      &kp C_BRI_UP     &kp C_BRIGHTNESS_AUTO    &out OUT_BLE  &out OUT_USB  &studio_unlock  &bootloader   &bt BT_CLR
                            &none              &none            &none                    &none         &none         &none
            >;

            label = "Func";
        };

        Mouse {
            label = "Mouse";
            bindings = <
  &kp LS(X)  &kp LC(LS(C))   &kp LC(C)  &kp LC(V)  &kp LS(INSERT)    &mkp MB1        &mkp MB2        &mkp MB3      &mkp MB4         &mkp MB5
  &sk LALT   &sk LEFT_SHIFT  &sk LGUI   &sk LCTRL  &sk RALT          &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none
  &none      &none           &none      &none      &tog 5            &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none
                             &none      &none      &none             &none           &none           &none
            >;
        };

        Maincra1 {
            bindings = <
  &kp ESC    &kp Q  &kp W  &kp E  &kp R        &trans  &trans  &trans  &trans  &trans
  &kp LSHFT  &kp A  &kp S  &kp D  &kp F        &trans  &trans  &trans  &trans  &trans
  &kp LCTRL  &kp Z  &kp X  &kp C  &kp V        &trans  &trans  &trans  &trans  &trans
                    &kp B  &mo 6  &kp SPACE    &tog 5  &trans  &trans
            >;
        };

        Maincra2 {
            bindings = <
  &kp O    &kp I      &kp U   &kp Y   &kp T     &trans  &trans  &trans  &trans  &trans
  &kp TAB  &kp K      &kp J   &kp H   &kp G     &trans  &trans  &trans  &trans  &trans
  &kp DOT  &kp COMMA  &kp M   &kp N   &kp B     &trans  &trans  &trans  &trans  &trans
                      &kp F3  &trans  &kp F5    &trans  &trans  &trans
            >;
        };
    };
};
